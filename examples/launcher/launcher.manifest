{
  "app": {
    "name": "pulse-launcher",
    "enable_restapi": true
  },
  "packages": [
    {
      "name": "PulseInputPlugin",
      "library": "packages/pulse_input/pulse_input.dll"
    },
    {
      "name": "PulseWindowPlugin",
      "library": "packages/pulse_window/pulse_window.dll",
      "dependencies": [
        "PulseInputPlugin"
      ],
      "config": {
        "primary_window": {
          "title": "PulseEngine Snake",
          "width": 800,
          "height": 600,
          "resizable": false,
          "external_graphics_context": true
        },
        "sdl_init_flags": 0
      }
    },
    {
      "name": "PulseAssetPlugin",
      "library": "packages/pulse_asset/pulse_asset.dll",
      "config": {
        "root_path": "assets",
        "max_requests_per_update": 64
      }
    },
    {
      "name": "PulseTransformPlugin",
      "library": "packages/pulse_transform/pulse_transform.dll"
    },
    {
      "name": "PulseGraphicPlugin",
      "library": "packages/pulse_graphics/pulse_graphics.dll",
      "dependencies": [
        "PulseWindowPlugin",
        "PulseAssetPlugin"
      ],
      "config": {
        "enable_debug_layer": true,
        "enable_vsync": true
      }
    },
    {
      "name": "PulseRendererPlugin",
      "library": "packages/pulse_renderer/pulse_renderer.dll",
      "dependencies": [
        "PulseWindowPlugin",
        "PulseGraphicPlugin",
        "PulseTransformPlugin"
      ]
    },
    {
      "name": "PulseImguiPlugin",
      "library": "packages/pulse_imgui/pulse_imgui.dll",
      "dependencies": [
        "PulseWindowPlugin",
        "PulseInputPlugin",
        "PulseAssetPlugin",
        "PulseGraphicPlugin"
      ]
    },
    {
      "name": "PulseSnakePlugin",
      "library": "packages/example-snake/example_snake.dll",
      "dependencies": [
        "PulseWindowPlugin",
        "PulseInputPlugin",
        "PulseAssetPlugin",
        "PulseTransformPlugin",
        "PulseGraphicPlugin",
        "PulseRendererPlugin",
        "PulseImguiPlugin"
      ]
    }
  ]
}