    "AssetRequest"
    .desc  "*const AssetMemoryLoadDesc"
    ()

func.AssetSystem.Build
    "AssetRequest"
    .desc  "*const AssetBuildDesc"
    ()

func.AssetSystem.BuildSync
    "AssetHandle"
    .desc  "*const AssetBuildDesc"
    ()

func.AssetSystem.GetState
