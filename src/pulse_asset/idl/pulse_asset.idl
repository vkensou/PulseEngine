    .request "AssetRequest"
    ()

func.AssetSystem.IsAlive
    "bool"
    .request "AssetRequest"
    ()

func.AssetSystem.IsReady
    "bool"
    .request "AssetRequest"
    ()

func.AssetSystem.GetError
    "cstring"
    .request "AssetRequest"
    ()

func.AssetSystem.GetHandle
    "AssetHandle"
    .request "AssetRequest"
    ()

func.AssetSystem.Cancel
    "void"
    .request "AssetRequest"
    ()

func.AssetSystem.Retain
    "bool"
    .handle     "AssetHandle"
    .outError   "*RetainErrorCode::Enum"
    ()

func.AssetSystem.Release
    "bool"
    .handle     "AssetHandle"
    .outError   "*ReleaseErrorCode::Enum"
    ()

func.AssetSystem.Borrow
    "bool"
    .handle     "AssetHandle"
    .outRef     "*?*anyopaque"
