    "EPulseAppAddPluginResult"
    .app   "PulseAppId"
    .desc  "*const AssetPluginDesc"
    ()

func.GetAssetSystem
    "?AssetSystemId"
    .app   "PulseAppId"

func.AssetSystem.RegisterType
    "EPulseResult"
    .desc           "*const AssetTypeDesc"
    ()

