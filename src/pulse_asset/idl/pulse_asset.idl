    ()

func.AssetSystem.MarkModified
    "void"
    .handle "AssetHandle"
    ()

func.AssetSystem.ForceUnloadAssets
    "void"
    .typeId "uint64_t"
    ()

func.AssetLoadTaskAddDependency
    "EPulseResult"
    .dependencyHint "*AssetLoadDependencyHint"
    .dependency     "AssetDepRef"
    .requirement    "LoadDependencyRequirement::Enum"
    ()

func.AssetSystem.ToAssetDepRefFromHandle
    "AssetDepRef"
    .handle         "AssetHandle"
    ()

func.AssetSystem.ToAssetDepRefFromRequest
    "AssetDepRef"
