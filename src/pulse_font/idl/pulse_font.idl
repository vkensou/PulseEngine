version(1)

typedef "bool"
typedef "float"
typedef "int32_t"
typedef "uint32_t"
typedef "uint64_t"
typedef "uint8_t"
typedef "anyopaque"
typedef "void"
typedef "size_t"
typedef "cstring"

--- From pulse_app.h
typedef "EPulseResult"
typedef "EPulseAppAddPluginResult"
typedef "PulseAppId"

--- From pulse_graphics.h
typedef "PulseTextureHandle" { cname = "PulseTextureHandle" }

--- From pulse_asset.h (defined by PULSE_DEFINE_ASSET_TYPE in pulse_font.h)
typedef "PulseFontHandle"
typedef "PulseFontRequest"
typedef "PulseFontChainHandle"
typedef "PulseFontChainRequest"

const_value.FontPluginDescVersion { value = "1u" }

--- Asset type id range 0x4000+ belongs to pulse_font (graphics 0x1000+, prefab 0x2000, datatable 0x3000)
const_value.TypeFont { value = "UINT64_C(0x4000)" }

const_value.TypeFontChain { value = "UINT64_C(0x4001)" }

struct.FontPluginDesc
    .structSize     "uint32_t"
    .version        "uint32_t"
    .atlasWidth     "uint32_t"
    .atlasHeight    "uint32_t"
    .maxAtlasCount  "uint32_t"
    .sdfPadding     "uint32_t"
    ()

--- 垂直度量，单位为目标字号的像素
struct.VerticalMetrics
    .ascent  "float"
    .descent "float"
    .lineGap "float"
    .height  "float"
    ()

--- 字形在 SDF 图集中的位置与摆放信息，y 轴向下，相对笔尖基线原点
struct.Glyph
    .valid   "bool"
    .page    "uint32_t"
    .x0      "float"
    .y0      "float"
    .x1      "float"
    .y1      "float"
    .u0      "float"
    .v0      "float"
    .u1      "float"
    .v1      "float"
    .advance "float"
    ()

func.FontPluginDescDefault
    "FontPluginDesc"
    ()

func.AddFontPlugin
    "EPulseAppAddPluginResult"
    .app  "PulseAppId"
    .desc "*const FontPluginDesc"
    ()

--- 发起异步字体加载（内部走 pulse_asset），支持 ttf/otf/ttc 与 BMFont 文本 .fnt（单页，PNG 与 .fnt 同目录）；is_ready 后用 get_handle 取字体凭证
func.FontLoad
    "PulseFontRequest"
    .app       "PulseAppId"
    .path      "cstring"
    .faceIndex "uint32_t"
    ()

--- 从内存字节流发起异步字体加载，name 用于扩展名判定（如 "latin.ttf"、"ascii.fnt"，fnt 的页面 PNG 仍从 VFS 同目录读取）
func.FontLoadFromMemory
    "PulseFontRequest"
    .app       "PulseAppId"
    .name      "cstring"
    .memory    "[]const anyopaque"
    .faceIndex "uint32_t"
    ()

--- 内置默认 bitmap 字体凭证，asset 系统缺失或未构建成功时返回无效 handle
func.FontDefault
    "PulseFontHandle"
    .app "PulseAppId"
    ()

--- 按顺序尝试的字体链，排版层只认链；匿名运行时链，无序列化标识；链尾自动追加默认字体（已在列表中则不重复追加）；每次调用生成独立资产并各持一份引用
func.FontCreateChain
    "PulseFontChainHandle"
    .app   "PulseAppId"
    .fonts "[]const PulseFontHandle"
    ()

--- 发起异步字体链加载
func.FontLoadChain
    "PulseFontChainRequest"
    .app  "PulseAppId"
    .path "cstring"
    ()

func.FontDestroyChain
    "void"
    .app   "PulseAppId"
    .chain "PulseFontChainHandle"
    ()

func.FontAdvance
    "float"
    .app       "PulseAppId"
    .chain     "PulseFontChainHandle"
    .codepoint "uint32_t"
    .size      "float"
    ()

func.FontKerning
    "float"
    .app   "PulseAppId"
    .chain "PulseFontChainHandle"
    .first "uint32_t"
    .second "uint32_t"
    .size  "float"
    ()

func.FontVerticalMetrics
    "VerticalMetrics"
    .app   "PulseAppId"
    .chain "PulseFontChainHandle"
    .size  "float"
    ()

--- 取字形并确保其已进图集
func.FontGlyph
    "Glyph"
    .app       "PulseAppId"
    .chain     "PulseFontChainHandle"
    .codepoint "uint32_t"
    .size      "float"
    ()

--- 当前图集页数
func.FontPageCount
    "uint32_t"
    .app "PulseAppId"
    ()

--- 图集失效代数：页淘汰或字体卸载使已分发字形的图集位置作废时加一；纯新增光栅化不加。缓存了 glyph UV 的消费方（排版结果）发现代数变化即需整体重排
func.FontAtlasGeneration
    "uint64_t"
    .app "PulseAppId"
    ()

--- 取图集页的 GPU 纹理凭证；page 必须小于 pulse_font_page_count，越界返回无效凭证；渲染器不存在（headless）时返回无效凭证；页存在时首次调用即同步创建纹理对象并返回稳定句柄，句柄在插件生命周期内不变，像素内容由插件延迟到渲染记录阶段上传（允许晚一帧）；创建失败视为致命错误，不会以无效凭证表达
func.FontPageTexture
    "PulseTextureHandle"
    .app  "PulseAppId"
    .page "uint32_t"
    ()

--- 排版结果里的一条 glyph 实例，坐标相对盒子原点、y 轴向下，page 为所属图集页
struct.GlyphInstance
    .x      "float"
    .y      "float"
    .width  "float"
    .height "float"
    .u0     "float"
    .v0     "float"
    .u1     "float"
    .v1     "float"
    .r      "float"
    .g      "float"
    .b      "float"
    .a      "float"
    .page   "uint32_t"
    ()
