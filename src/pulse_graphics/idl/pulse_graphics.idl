switch_table.ShaderPropertyIsUniform
    .arg            "ShaderPropertyType::Enum"
    .ret            "bool"
    .cases          ({
                        { Float = true },
                        { Float2 = true },
                        { Float3 = true },
                        { Float4 = true },
                        { Int = true },
                        { Mat4 = true },
                    })
    .default        (false)