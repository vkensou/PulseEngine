--- Function pointer: render record callback
funcptr.RenderRecordCallback
    "void"
    .app        "PulseAppId"
    .graph      "*pulse_rendergraph_t"
    .userData   "?*anyopaque"

--- Plugin descriptor
struct.GraphicsPluginDesc
    .structSize             "uint32_t"
    .version                "uint32_t"
    .backend                "ECGPUBackend"
    .swapchainFormat        "ECGPUTextureFormat"
    .imageCount             "uint32_t"
    .enableDebugLayer       "bool"
    .enableGpuBasedValidation "bool"
    .enableVsync            "bool"
    .recordCallback         "RenderRecordCallback"
    .recordUserData         "?*anyopaque"
    ()

--- Renderer state (opaque at C API level)
struct.Renderer
    .instance   "CGPUInstanceId"
    .adapter    "CGPUAdapterId"
    .device     "CGPUDeviceId"
    .graphicsQueue "CGPUQueueId"
    .presentQueue "CGPUQueueId"
    .renderPass "CGPURenderPassId"
    .backend    "ECGPUBackend"
    .swapchainFormat "ECGPUTextureFormat"
    .imageCount "uint32_t"
    .frameIndex "uint64_t"
    ()

--- Window surface
struct.Surface
    .instance "CGPUInstanceId"
    .surface  "CGPUSurfaceId"
    ()

--- Window swapchain
struct.Swapchain
    .device                   "CGPUDeviceId"
    .swapchain                "CGPUSwapChainId"
    .backbufferViews          "*CGPUTextureViewId"
    .framebuffers             "*CGPUFramebufferId"
    .imageAvailableSemaphores "*CGPUSemaphoreId"
    .renderFinishedSemaphores "*CGPUSemaphoreId"
    .backbufferCount          "uint32_t"
    .width                    "uint32_t"
    .height                   "uint32_t"
    .currentBackbufferIndex   "uint32_t"
    .backbuffers              "*pulse_backbuffer_data_t"
    .currentBackbuffer        "*pulse_backbuffer_data_t"
    ()

--- Record callback descriptor
struct.RenderRecordCallbackDesc
    .callback  "RenderRecordCallback"
    .userData  "?*anyopaque"
    .priority  "int32_t"
    ()

--- Shader library create desc
struct.ShaderLibraryCreateDesc
    .code     "*const anyopaque"
    .codeSize "uint32_t"
    ()

--- Shader library load desc
struct.ShaderLibraryLoadDesc
    .path "cstring"
    ()

--- Shader property role
enum.ShaderPropertyRole { underscore }
    .Material
    .NonMaterial
    ()

--- Shader property type
enum.ShaderPropertyType { underscore }
    .Unknown
    .Float
    .Float2
    .Float3
    .Float4
    .Int
    .Mat4
    .Texture
    .Sampler
    ()

--- Shader property descriptor
struct.ShaderPropertyDesc
    .name    "cstring"
    .type    "ShaderPropertyType::Enum"
    .role    "ShaderPropertyRole::Enum"
    .set     "uint32_t"
    .binding "uint32_t"
    .offset  "uint32_t"
    .size_   "uint32_t"
    ()

--- Shader create from binary desc
struct.ShaderCreateFromBinaryDesc
    .vsData             "*const anyopaque"
    .vsSize             "uint32_t"
    .fsData             "*const anyopaque"
    .fsSize             "uint32_t"
    .blendDesc          "CGPUBlendStateDescriptor"
    .depthDesc          "CGPUDepthStateDescriptor"
    .rasterizerState    "CGPURasterizerStateDescriptor"
    .propertyCount      "uint32_t"
    .pProperties        "*const ShaderPropertyDesc"
    ()

--- Shader create from file desc
struct.ShaderCreateFromFileDesc
    .vertPath           "cstring"
    .fragPath           "cstring"
    .blendDesc          "CGPUBlendStateDescriptor"
    .depthDesc          "CGPUDepthStateDescriptor"
    .rasterizerState    "CGPURasterizerStateDescriptor"
    .propertyCount      "uint32_t"
    .pProperties        "*const ShaderPropertyDesc"
    ()

--- Compute shader create from binary desc
struct.ComputeShaderCreateFromBinaryDesc
    .csData "*const anyopaque"
    .csSize "uint32_t"
    ()

--- Compute shader create from file desc
struct.ComputeShaderCreateFromFileDesc
    .csPath "cstring"
    ()

--- Buffer create desc
struct.GraphicsBufferCreateDesc
    .desc     "CGPUBufferDescriptor"
    .dataSize "uint64_t"
    .data     "*const anyopaque"
    ()

--- Sampler create desc
struct.SamplerCreateDesc
    .desc "CGPUSamplerDescriptor"
    ()

--- Texture create desc
struct.TextureCreateDesc
    .desc            "CGPUTextureDescriptor"
    .pixelDataSize   "uint64_t"
    .pixelData       "*const anyopaque"
    .generateMipmaps "bool"
    ()

--- Texture load desc
struct.TextureLoadDesc
    .filepath        "cstring"
    .generateMipmaps "bool"
    ()

--- Mesh create from data desc
struct.MeshCreateFromDataDesc
    .vertexCount          "uint32_t"
    .vertexStride         "uint32_t"
    .layout               "CGPUVertexLayout"
    .vertexData           "*const uint8_t"
    .updateVertexDataFromComputeShader "bool"
    .topology             "ECGPUPrimitiveTopology"
    .indexCount           "uint32_t"
    .indexStride          "uint32_t"
    .indexData            "*const uint8_t"
    .updateIndexDataFromComputeShader "bool"
    ()

--- Mesh create dynamic desc
struct.MeshCreateDynamicDesc
    .topology    "ECGPUPrimitiveTopology"
    .layout      "CGPUVertexLayout"
    .indexStride "uint32_t"
    ()

--- Material create desc
struct.MaterialCreateDesc
    .shader "ShaderHandle"
    ()

