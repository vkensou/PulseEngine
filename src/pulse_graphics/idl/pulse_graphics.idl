typedef "ECGPUPrimitiveTopology"

--- From pulse_math.h
typedef "HMM_Vec4" { cname = "HMM_Vec4" }
typedef "HMM_Mat4" { cname = "HMM_Mat4" }

--- Constants
const_value.GraphicsPluginDescVersion { value = "1u" }
const_value.TypeTexture { value = "UINT64_C(0x1000)" }
const_value.TypeGraphicsBuffer { value = "UINT64_C(0x1001)" }
const_value.TypeSampler { value = "UINT64_C(0x1002)" }
const_value.TypeShaderLibrary { value = "UINT64_C(0x1003)" }
const_value.TypeShader { value = "UINT64_C(0x1004)" }
const_value.TypeComputeShader { value = "UINT64_C(0x1005)" }
const_value.TypeMesh { value = "UINT64_C(0x1006)" }
const_value.TypeMaterial { value = "UINT64_C(0x1007)" }

