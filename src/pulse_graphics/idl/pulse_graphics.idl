version(1)

typedef "bool"
typedef "char"
typedef "float"
typedef "double"
typedef "int8_t"
typedef "int32_t"
typedef "int64_t"
typedef "uint8_t"
typedef "uint16_t"
typedef "uint32_t"
typedef "uint64_t"
typedef "uintptr_t"
typedef "va_list"
typedef "void"
typedef "anyopaque"
typedef "size_t"
typedef "cstring"

--- External types from other modules
typedef "EPulseResult"
typedef "PulseAppId"
typedef "ecs_entity_t"
typedef "pulse_rendergraph_t"
typedef "pulse_renderpass_encoder_t"
typedef "pulse_texture_handle_t"
typedef "pulse_buffer_handle_t"
typedef "pulse_backbuffer_data_t"

--- CGPU types
typedef "ECGPUBackend"
typedef "ECGPUTextureFormat"
typedef "CGPUInstanceId"
typedef "CGPUAdapterId"
