    .minDepth "float"
    .maxDepth "float"
    ()

func.RenderPassEncoder.SetScissor { mut }
    "void"
    .x        "uint32_t"
    .y        "uint32_t"
    .width    "uint32_t"
    .height   "uint32_t"
    ()

func.RenderPassEncoder.PushConstants { mut }
    "void"
    .shader   "PulseShaderHandle"
    .name     "cstring"
    .data     "*const anyopaque"
    ()

func.RenderPassEncoder.ResolveBuffer { mut }
    "CGPUBufferId"
    .bufferHandle "RGBufferHandle"
    ()

func.RenderPassEncoder.ResolveTextureView { mut }
    "CGPUTextureViewId"
    .textureHandle "RGTextureHandle"
    ()

func.UploadPassEncoder.Upload { mut }
    "void"
    .offset         "uint64_t"
    .length         "uint64_t"
    .data           "*const anyopaque"

switch_table.ShaderPropertyIsUniform
    .arg            "ShaderPropertyType::Enum"
    .ret            "bool"
    .cases          ({
                        { Float = true },
                        { Float2 = true },
                        { Float3 = true },
                        { Float4 = true },
                        { Int = true },
                        { Mat4 = true },
                    })
    .default        (false)
