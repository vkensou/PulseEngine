version(1)

typedef "bool"
typedef "char"
typedef "float"
typedef "double"
typedef "int8_t"
typedef "int32_t"
typedef "int64_t"
typedef "uint8_t"
typedef "uint16_t"
typedef "uint32_t"
typedef "uint64_t"
typedef "uintptr_t"
typedef "va_list"
typedef "void"
typedef "anyopaque"
typedef "size_t"
typedef "cstring"

--- From pulse_app.h (use exact C type names since the codegen overwrites custom cname)
typedef "EPulseResult"
typedef "EPulseAppAddPluginResult"
typedef "PulseAppId"

--- From flecs.h
typedef "ecs_entity_t" { cname = "ecs_entity_t" }

--- Forward declaration for ImGuiContext (defined in imgui.h)
typedef "ImGuiContext" { cname = "ImGuiContext" }

const_value.ImguiPluginDescVersion { value = "1u" }

--- ImGui plugin flag bits (PulseImguiPluginFlags = EPulseFlags)
flag.ImguiPlugin { bits = 32, base = 1, underscore }
    .EnableDocking              --- Enable docking layout
    .Default { "EnableDocking" }
    ()

struct.ImguiPluginDesc
    .structSize    "uint32_t"
    .version       "uint32_t"
    .flags         "ImguiPlugin"
    .iniFilename   "cstring"       --- NULL -> default "imgui.ini"
    ()

struct.ImguiContext
    .context "*ImGuiContext"
    ()

func.ImguiPluginDescDefault
    "ImguiPluginDesc"
    ()

func.AddImguiPlugin
    "EPulseAppAddPluginResult"
    .app  "PulseAppId"
    .desc "*const ImguiPluginDesc"
    ()

func.ImguiGetContext
    "?*ImGuiContext"
    .app "PulseAppId"
    ()

func.ImguiGetPhase
    "ecs_entity_t"
    .app "PulseAppId"
    ()
