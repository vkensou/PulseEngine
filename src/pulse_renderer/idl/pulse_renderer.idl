version(1)

typedef "bool"
typedef "char"
typedef "float"
typedef "int32_t"
typedef "uint32_t"
typedef "void"
typedef "cstring"

--- From pulse_app.h
typedef "EPulseResult"
typedef "EPulseAppAddPluginResult"
typedef "PulseAppId"

--- From flecs.h
typedef "ecs_entity_t"

--- From pulse_math.h
typedef "HMM_Vec4" { cname = "HMM_Vec4" }

--- From pulse_graphics.h
typedef "PulseMeshHandle" { cname = "PulseMeshHandle" }
typedef "PulseMaterialHandle" { cname = "PulseMaterialHandle" }

typedef "PulseTextBlockDesc"

--- Constants
const_value.RendererPluginDescVersion { value = "1u" }

--- 单个实体内联文本缓冲上限，含结尾 '\0'
const_value.TextMaxChars { value = "256u" }

--- ECS Components
component.Camera
    .windowEntity "ecs_entity_t"
    .fov          "float" { min = 0.001, max = 179.0 }
    .nearPlane    "float" { min = 0.001, max = 10 }
    .farPlane     "float" { min = 0.01, max = 4000 }
    .orthographicSize   "float" { min = 0.001, max = 100 }
    .orthographic "bool"
    .clearColor   "uint32_t"
    ()

component.Light
    .color "HMM_Vec4"
    ()

component.Renderable
    .mesh     "PulseMeshHandle"
    .material "PulseMaterialHandle"
    ()

--- 文字渲染组件；block 为 pulse_text 排版块 id，text 为内联 utf8；revision 由 TextSet 自增，驱动懒重排
component.Text
    .block     "PulseTextBlockDesc"
    .text      "[TextMaxChars] char"
    .boxWidth  "float"
    .boxHeight "float"
    .revision  "uint32_t" { noreflex = true }
    ()

--- Functions
func.AddRendererPlugin
    "EPulseAppAddPluginResult"
    .app  "PulseAppId"
    ()
