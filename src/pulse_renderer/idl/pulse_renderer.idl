version(1)

typedef "bool"
typedef "float"
typedef "int32_t"
typedef "uint32_t"
typedef "void"
typedef "cstring"

--- From pulse_app.h
typedef "EPulseResult"
typedef "PulseAppId"

--- From flecs.h
typedef "ecs_entity_t"

--- From pulse_math.h (forward — 实际类型在 pulse_math.h 中，这里仅声明引用)
--- HMM_Vec4 的类型名
typedef "HMM_Vec4" { cname = "HMM_Vec4" }

--- From pulse_graphics.h (值类型句柄)
typedef "PulseMeshHandle" { cname = "PulseMeshHandle" }
typedef "PulseMaterialHandle" { cname = "PulseMaterialHandle" }

--- Constants
const_value.RendererPluginDescVersion { value = "1u" }

--- ECS Components
struct.Camera
    .windowEntity "ecs_entity_t"
    .fov          "float"
    .nearPlane    "float"
    .farPlane     "float"
    ()

struct.Light
    .color "HMM_Vec4"
    ()

struct.Renderable
    .mesh     "PulseMeshHandle"
    .material "PulseMaterialHandle"
    ()

--- Functions
func.AddRendererPlugin
    "EPulseResult"
    .app  "PulseAppId"
    ()
