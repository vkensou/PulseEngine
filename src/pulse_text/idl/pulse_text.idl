version(1)

typedef "bool"
typedef "float"
typedef "int32_t"
typedef "uint32_t"
typedef "uint64_t"
typedef "void"
typedef "size_t"
typedef "cstring"

--- From pulse_app.h
typedef "EPulseResult"
typedef "EPulseAppAddPluginResult"
typedef "PulseAppId"

--- From pulse_font.h
typedef "PulseGlyphInstance" { cname = "PulseGlyphInstance" }
typedef "PulseFontChainHandle" { cname = "PulseFontChainHandle" }

const_value.TextPluginDescVersion { value = "1u" }

--- 水平对齐
enum.TextAlignH { underscore }
    .Left
    .Center
    .Right
    ()

--- 垂直对齐
enum.TextAlignV { underscore }
    .Top
    .Middle
    .Bottom
    ()

--- RGBA 颜色，分量 0..1
struct.TextColor
    .r "float"
    .g "float"
    .b "float"
    .a "float"
    ()

--- 排版参数；按值传入排版接口，chain 为字体链资产凭证，lineHeight 为行高系数（<=0 用字体自然行高），color 为默认文字颜色
--- autoSize 为真时忽略 box 尺寸：不换行不裁剪，按内容自动计算宽高，align 表示布局原点相对内容盒的位置（CENTER/MIDDLE 即以原点为文字中心）
struct.TextBlockDesc
    .chain      "PulseFontChainHandle"
    .size       "float"
    .color      "TextColor"
    .alignH     "TextAlignH::Enum"
    .alignV     "TextAlignV::Enum"
    .lineHeight "float"
    .autoSize   "bool"
    ()

--- 排版结果；instances 矩形相对盒子原点、y 轴向下；box_height 装不下的行直接丢弃，不做溢出标记
struct.TextLayout
    .instances  "[]const PulseGlyphInstance"
    .width      "float"
    .height     "float"
    .lineCount  "uint32_t"
    ()

--- 排版尺寸结果
struct.TextMeasure
    .width     "float"
    .height    "float"
    .lineCount "uint32_t"
    ()

func.AddTextPlugin
    "EPulseAppAddPluginResult"
    .app  "PulseAppId"
    ()

--- 在 boxWidth × boxHeight 的盒子里排版 utf8 文本，产出 glyph 实例流；boxWidth <= 0 不按宽度断行，boxHeight <= 0 不按高度截断；desc.autoSize 为真时 box 尺寸被忽略，按内容自动计算并按 align 锚定原点；结果归调用方所有，用完调 pulse_text_layout_free 释放
func.TextLayout
    "?*TextLayout" { ret = { owner = true } }
    .app       "PulseAppId"
    .desc      "*const TextBlockDesc"
    .text      "cstring"
    .boxWidth  "float"
    .boxHeight "float"
    ()

--- 只算尺寸不产实例，与 layout 共用同一套断行实现；boxWidth <= 0 为自然尺寸
func.TextMeasure
    "TextMeasure"
    .app      "PulseAppId"
    .desc     "*const TextBlockDesc"
    .text     "cstring"
    .boxWidth "float"
    ()

--- 释放 pulse_text_layout 的结果
func.TextLayoutFree
    "void"
    .app    "PulseAppId"
    .layout "*TextLayout" { owner = true }
    ()
