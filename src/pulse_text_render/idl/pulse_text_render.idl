version(1)

typedef "bool"
typedef "char"
typedef "float"
typedef "int32_t"
typedef "uint32_t"
typedef "void"
typedef "cstring"

--- From pulse_app.h
typedef "EPulseAppAddPluginResult"
typedef "PulseAppId"

--- From pulse_text.h
typedef "PulseTextBlockDesc"

--- Constants
const_value.TextRenderPluginDescVersion { value = "1u" }

--- 单个实体内联文本缓冲上限，含结尾 '\0'
const_value.TextMaxChars { value = "256u" }

--- 文字渲染组件；block 为 pulse_text 排版块 id，text 为内联 utf8
--- scissor 为相对文字自身位置的裁剪矩形，与字形实例同处局部像素坐标（y 向下），
--- width/height 均大于 0 时生效，渲染后自动重置为全屏
component.Text
    .block         "PulseTextBlockDesc"
    .text          "[TextMaxChars] char"
    .boxWidth      "float"
    .boxHeight     "float"
    .scissorX      "float"
    .scissorY      "float"
    .scissorWidth  "float"
    .scissorHeight "float"
    .sortingOrder  "int32_t"
    .revision      "uint32_t" { noreflex = true }
    ()

func.AddTextRenderPlugin
    "EPulseAppAddPluginResult"
    .app  "PulseAppId"
    ()
